# ==============================================================================
# GitHub Noob Toolkit (GNT) · Environment Variables Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL 16)
# ------------------------------------------------------------------------------
# For local Docker Compose:
DATABASE_URL=postgresql+asyncpg://gnt_user:gnt_secret_password@localhost:5432/gnt_db
# For SQLite local file test mode:
# DATABASE_URL=sqlite+aiosqlite:///./gnt.db

POSTGRES_USER=gnt_user
POSTGRES_PASSWORD=gnt_secret_password
POSTGRES_DB=gnt_db

# ------------------------------------------------------------------------------
# 2. JWT Session Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. GitHub App & OAuth Configuration
# ------------------------------------------------------------------------------
# Create your GitHub App at: https://github.com/settings/apps/new
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.your_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_random_hmac_webhook_secret_string

# GitHub App RSA Private Key (Paste PEM block or path to private-key.pem)
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 4. Stripe Subscriptions & Monetization
# ------------------------------------------------------------------------------
# Obtain keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
# Webhook signing secret from: stripe listen --forward-to localhost:8000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs created in your Stripe Product Catalog
STRIPE_PRICE_ID_PRO=price_1Q...
STRIPE_PRICE_ID_TEAM=price_1Q...

# ------------------------------------------------------------------------------
# 5. Frontend Public Variables (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
